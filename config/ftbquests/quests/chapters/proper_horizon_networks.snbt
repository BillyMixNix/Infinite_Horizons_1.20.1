			]
			title: "Charge and Crystal"
			x: 1.0d
			y: 0.0d
		}
		{
			dependencies: ["063E49B2A8EEF4C5"]
			description: [
				"Use an Inscriber to manufacture logic, calculation, and engineering processors. These are control components, so automate them before advanced storage consumes them in bulk."
			]
			id: "128FFED7092D5DD8"
			tasks: [
				{ id: "271AE74B7A6091F6", item: "ae2:inscriber", type: "item" }

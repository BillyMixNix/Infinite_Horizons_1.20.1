			]
			title: "Storage at the Source"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7F8D5FE85503AAD3"]
			description: ["Applied Energistics begins with charged Certus Quartz. Build a charger and establish a repeatable route to charged crystals before constructing the network itself."]
			id: "063E49B2A8EEF4C5"
			tasks: [
				{ id: "16B46F2869CF6D6E", item: "ae2:charger", type: "item" }

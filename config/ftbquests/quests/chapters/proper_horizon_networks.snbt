		{
			dependencies: ["1438522D85007BC2"]
			description: [
				"A digital network should organize an existing economy, not replace the need to build one. Begin by making local bulk storage dependable at the factory and outposts."
				"Drawers and ordinary containers remain valuable as production buffers even after a terminal exists."
			]
			id: "7F8D5FE85503AAD3"
			tasks: [
				{ id: "FA5848F2415B92A7", item: "functionalstorage:oak_1", type: "item" }

			]
			title: "One Inventory, Deliberately"
			x: 4.0d
			y: -0.5d
		}
		{
			dependencies: ["1BABB1C961DDCCA3"]
			description: ["Upgrade the terminal for crafting and encode the first patterns. The network should save attention on repeated components, not make the player forget how production works."]
			id: "9278CC9C4040E70B"

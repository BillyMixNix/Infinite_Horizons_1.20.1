			y: -0.5d
		}
		{
			dependencies: ["9278CC9C4040E70B"]
			description: [
				"Attach a Pattern Provider to a real machine line and autocraft one component with at least two processing steps."
				"A recipe that only combines items in the terminal does not demonstrate factory integration."

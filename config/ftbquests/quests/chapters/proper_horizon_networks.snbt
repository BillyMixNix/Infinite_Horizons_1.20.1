				{ id: "ADD2F4C8572F4D0A", item: "ae2:engineering_processor", type: "item" }
			]
			title: "Processors, Not Trinkets"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["128FFED7092D5DD8"]
			description: [
				"Construct an ME Controller and Drive. The controller turns the storage system into infrastructure with power and channel constraints rather than a magic chest."
				"Place the network in a central operations building with room to expand and service it."

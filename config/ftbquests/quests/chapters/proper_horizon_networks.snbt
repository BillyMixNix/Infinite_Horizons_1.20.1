			x: 3.0d
			y: 0.0d
		}
		{
			dependencies: ["70D641D2E6D00DF3"]
			description: ["Install a modest storage cell and terminal. Large cells are not a substitute for sensible bulk storage and subnet design; prove the network with a small cell first."]
			id: "1BABB1C961DDCCA3"

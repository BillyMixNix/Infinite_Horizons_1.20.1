		{
			dependencies: ["82A6CF90EB526B55"]
			description: ["Hammer cobblestone into gravel and sift the gravel for iron. Collect nuggets until you can form an ingot. This temporary bootstrap remains explicit while natural ore generation is rebuilt."]

			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["A09206CBB7AEBED7"]
			description: ["Build bulk freight storage and portable storage interfaces. Freight should enter and leave the train without the player carrying every stack by hand."]
			id: "97BD384979DD1A3E"

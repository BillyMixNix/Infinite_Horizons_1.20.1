		}
		{
			dependencies: ["E1BCCCD016424781"]
			description: ["Establish a permanent outpost with shelter, light, local storage, food, and a way to process basic materials. An outpost is a working place, not a chest abandoned in a field."]
			id: "A09206CBB7AEBED7"
			tasks: [

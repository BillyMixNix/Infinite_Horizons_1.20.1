			]
			title: "Coke and Creosote"
			x: 1.0d
			y: 0.0d
		}
		{
			dependencies: ["19FDE15E15185172"]
			description: [
				"Construct the crude blast furnace and make steel. Steel is the structural gate for electrical industry and should come from a visible fuel-and-furnace chain."
				"Other mods may process steel later, but this is the campaign's first canonical route."
			]
			id: "FB728FBF7F3EDFE5"

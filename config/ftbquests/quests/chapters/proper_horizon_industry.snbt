				"80156AC922B8DB1D"
			]
			description: [
				"Turn mechanical motion into electricity with an Immersive Engineering dynamo and connect it with copper wire. A power source without distribution is not a grid."
				"Keep the wires visible. This first electrical network establishes the scale and language that compact systems may improve later."
			]
			id: "A6C027470F60A777"

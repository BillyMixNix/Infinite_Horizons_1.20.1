			title: "Heavy Foundations"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["17EDED4219E63841"]
			description: ["Process coal into coke and collect creosote. Coke is a deliberate industrial fuel step; creosote becomes treated timber for durable infrastructure."]
			id: "19FDE15E15185172"
			tasks: [
				{ id: "4DAA84A3BF606EFD", item: "kubejs:coal_coke", type: "item" }

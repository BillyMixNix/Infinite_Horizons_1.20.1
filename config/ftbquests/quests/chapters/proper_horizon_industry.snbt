			]
			title: "The First Grid"
			x: 3.0d
			y: 0.0d
		}
		{
			dependencies: ["A6C027470F60A777"]
			description: ["Generate and move at least 10,000 FE through the industrial district. The number is small; the point is proving that generation, wiring, and consumption all function together."]
			id: "67A8ED4F9892D26A"

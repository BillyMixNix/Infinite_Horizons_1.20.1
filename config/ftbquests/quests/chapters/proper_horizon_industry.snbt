			title: "The Steel Age"
			x: 2.0d
			y: -0.5d
		}
		{
			dependencies: ["19FDE15E15185172"]
			description: ["Use creosote to make treated wood. Build poles, platforms, and machine spaces that visually distinguish the industrial district from the original homestead."]
			id: "80156AC922B8DB1D"
